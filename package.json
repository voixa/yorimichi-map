{
  "name": "machiaruki-gacha",
  "version": "1.0.0",
  "description": "街歩きガチャ — 街の散歩コースをガチャで引く Web 地図サービス",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install chromium --with-deps",
    "serve": "python -m http.server 8765",
    "build:ios": "node scripts/sync-www.mjs",
    "ios:sync": "npm run build:ios && npx cap sync ios",
    "ios:add": "npm run build:ios && npx cap add ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@playwright/test": "^1.46.0"
  }
}
